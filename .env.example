# Puertos e interfaces expuestas (Caddy es el unico servicio con puerto publicado)
CADDY_BIND_HOST=0.0.0.0
CADDY_PORT=8084
# Por defecto solo permite redes privadas/LAN (puedes restringirlo a la IP exacta de tu Nginx)
CADDY_ALLOWED_IPS=private_ranges
TZ=America/Argentina/Buenos_Aires

# Configuracion de WAHA (Core + motor GOWS)
WAHA_IMAGE=devlikeapro/waha:latest
WAHA_SESSION=default
WAHA_API_KEY=cambia_esta_api_key_segura
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=cambia_esta_password
WAHA_WEBHOOK_HMAC_KEY=cambia_esta_clave_hmac_webhook
WAHA_CLIENT_DEVICE_NAME=Asistodo
WAHA_CLIENT_BROWSER_NAME=Desktop
WAHA_TIMEOUT_MS=60000

# Para desarrollo local fuera de Docker (docker-compose usa http://waha:3000)
WAHA_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/app/masivos.db
# Solo si corres "waha" en Docker y "npm run dev" local en Windows/Mac:
# WHATSAPP_HOOK_URL=http://host.docker.internal:4000/api/webhooks/waha

# Normalizacion y plantilla por defecto (Asistodo Argentina)
DEFAULT_COUNTRY_CODE=549
DEFAULT_MESSAGE_TEMPLATE=Usted, {{nombre}} registra deuda con Asistodo, regularice enviando un mensaje de whatsapp al 1176560109

# Worker anti-baneo - Perfil Moderado (tandas de 25, pausa max 60 min, tope 125/dia)
WORKER_MIN_DELAY_MS=20000
WORKER_MAX_DELAY_MS=60000
WORKER_POLL_INTERVAL_MS=3000
WORKER_CHUNK_SIZE=25
WORKER_CHUNK_PAUSE_MIN_MS=2700000
WORKER_CHUNK_PAUSE_MAX_MS=3600000
WORKER_DAILY_LIMIT=125
WORKER_SUGGESTED_BATCH_SIZE=25
WORKER_MAX_BATCH_SIZE=1000
WORKER_ENABLED=true

# Horario comercial estricto (prohibido enviar fuera de este rango)
# Dias: 0=Dom, 1=Lun, 2=Mar, 3=Mie, 4=Jue, 5=Vie, 6=Sab
BUSINESS_HOURS_ENABLED=true
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=19:00
BUSINESS_ALLOWED_DAYS=1,2,3,4,5,6

# Exigir login obligatorio al iniciar (poner true en produccion / Docker; falla al arrancar si falta ADMIN_API_TOKEN)
AUTH_REQUIRED=true
# Clave de acceso al panel web y API (si esta definida activa la pantalla de login; si queda vacia entra directo)
ADMIN_API_TOKEN=cambia_esta_clave_de_acceso
